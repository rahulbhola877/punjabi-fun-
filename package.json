  "dependencies": {
    "@babylonjs/core": "9.28.0",
    "@babylonjs/havok": "1.3.14",
    "@fontsource/baloo-paaji-2": "5.3.0",
    "@fontsource/noto-sans-gurmukhi": "5.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@types/node": "22.19.1",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
